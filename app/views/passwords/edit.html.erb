<% content_for :title, "Nueva contraseña" %>

<div class="mx-auto mt-12 max-w-md">
  <h1 class="mb-6 text-center text-3xl font-bold">Nueva contraseña</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "card space-y-5" do |form| %>
    <div>
      <%= form.label :password, "Nueva contraseña", class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Repite la contraseña", class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>

    <%= form.submit "Guardar", class: "btn btn-primary" %>
  <% end %>
</div>
